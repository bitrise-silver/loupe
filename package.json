{
  "name": "loupe",
  "version": "0.1.0",
  "description": "In-app, component-anchored feedback for React Native with fingerprint-gated OTA on Bitrise.",
  "license": "MIT",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "align-deps": "expo install --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~54.0.25",
    "expo-constants": "~18.0.0",
    "expo-device": "~8.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-root-siblings": "^5.0.1",
    "react-native-view-shot": "^5.0.1",
    "react-native-worklets": "~0.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "note": "Native module versions above are approximate for Expo SDK 54. Run `npx expo install --fix` to pin the SDK-correct versions. Add @shopify/react-native-skia and react-native-network-logger with `npx expo install` when enabling drawing/network capture."
    }
  }
}
