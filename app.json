{
  "expo": {
    "name": "Loupe",
    "slug": "loupe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.loupe.example"
    },
    "android": {
      "package": "dev.loupe.example"
    },
    "plugins": [
      [
        "@bitrise/code-push-sdk/expo",
        {
          "ios": {
            "CodePushDeploymentKey": "YOUR_CODEPUSH_DEPLOYMENT_KEY",
            "CodePushServerURL": "https://YOUR_WORKSPACE_SLUG.codepush.bitrise.io"
          },
          "android": {
            "CodePushDeploymentKey": "YOUR_CODEPUSH_DEPLOYMENT_KEY",
            "CodePushServerURL": "https://YOUR_WORKSPACE_SLUG.codepush.bitrise.io"
          }
        }
      ]
    ]
  }
}
